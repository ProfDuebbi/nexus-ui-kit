{
  "name": "Nexus UI Kit",
  "version": "1.0.1",
  "autor": "Brainstorm Studios · DrDübbi",
  "lizenz": "CC BY-NC 4.0",
  "veroeffentlicht": "2026-07-01",
  "herkunft": "https://brainstorm-studios.de/de/arbeiten/nexus-ui-kit",
  "farben": {
    "flaechen": {
      "bg":      { "wert": "#0e0f13", "zweck": "Seitengrund" },
      "surface": { "wert": "#15171c", "zweck": "Karte, Panel" },
      "elev":    { "wert": "#1b1e25", "zweck": "angehoben: Hover, Tabellenkopf" },
      "elev2":   { "wert": "#21242c", "zweck": "doppelt angehoben: aktiv" },
      "line":    { "wert": "#262a33", "zweck": "ruhige Kante" },
      "line2":   { "wert": "#343945", "zweck": "betonte Kante" }
    },
    "schrift": {
      "text":  { "wert": "#e7e8eb", "zweck": "Fliesstext, Ueberschriften" },
      "muted": { "wert": "#aab1bd", "zweck": "Zweitrang, Beschriftungen" },
      "faint": { "wert": "#828a99", "zweck": "Randnotizen, Platzhalter" }
    },
    "akzent": {
      "akzent":   { "wert": "#8b5cf6", "zweck": "Hauptfarbe, frei waehlbar" },
      "akzent-2": { "wert": "#ff2e88", "zweck": "warmer Pol des Verlaufs" },
      "akzent-3": { "wert": "#4f7dff", "zweck": "kuehler Pol des Verlaufs" },
      "grad":     { "wert": "linear-gradient(105deg, #4f7dff 0%, #8b5cf6 50%, #ff2e88 100%)", "zweck": "Marken-Verlauf" }
    },
    "bedeutung": {
      "ok":     { "wert": "#3dd68c", "zweck": "erledigt, online" },
      "warn":   { "wert": "#ffd166", "zweck": "in Arbeit, Achtung" },
      "danger": { "wert": "#f0555f", "zweck": "Fehler, loeschen" },
      "info":   { "wert": "#4f7dff", "zweck": "offen, neutral" }
    }
  },
  "bewegung": {
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
    "dauer": { "hover": "160ms", "zustand": "200-250ms", "einblenden": "280-500ms" },
    "stagger": "35ms pro Element"
  },
  "schriften": {
    "sans": { "familie": "Inter", "zweck": "Text, Ueberschriften", "gewichte": [400, 600, 700, 800] },
    "mono": { "familie": "JetBrains Mono", "zweck": "Kicker, Zahlen, Tasten", "gewichte": [400, 600] }
  },
  "radien": { "sm": "9px", "base": "11px", "md": "14px", "lg": "16px", "pill": "999px" }
}
